[Unit]
Description=Whisper speech-to-text hotkey daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Binary is installed to ~/.local/bin/ by install.sh.
# All settings come from ~/.config/whisper-stt/config.toml — edit that file
# rather than adding flags here.
ExecStart=%h/.local/bin/whisper-stt
Restart=on-failure
RestartSec=3

# Inherit the user's display so gohook and xdotool can reach the X session.
Environment=DISPLAY=:0
# Uncomment if running on Wayland + XWayland:
# Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=graphical-session.target
